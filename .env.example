# --- Servidor HTTP -----------------------------------------------------------
PORT=8080
# Escuta apenas em loopback por padrao; exponha via proxy reverso com TLS.
BIND_ADDRESS=127.0.0.1

# --- Banco local (SQLite) ----------------------------------------------------
DB_PATH=./data/inventory.db

# --- Cifra das credenciais SSH em repouso (AES-256-GCM) ----------------------
# 32 bytes em base64. Gere com: npm run gen-key
# Guarde FORA do repositorio e fora do mesmo backup do banco.
SECRETS_KEY=CHANGE_ME

# --- Verificacao de host key -------------------------------------------------
# Arquivo no formato OpenSSH known_hosts. Popule com ssh-keyscan e CONFIRME o
# fingerprint por um canal confiavel antes de usar.
KNOWN_HOSTS_PATH=./data/known_hosts

# --- Autenticacao da API (escolha um ou ambos) -------------------------------
# Token bearer (minimo 32 caracteres). Gere com: npm run gen-key
API_TOKEN=CHANGE_ME
# Basic auth com hash bcrypt (gere com: npm run hash-password)
BASIC_AUTH_USER=CHANGE_ME
BASIC_AUTH_HASH=CHANGE_ME

# --- Coleta -------------------------------------------------------------------
# Canais SSH simultaneos por conexao (sshd MaxSessions padrao = 10).
COLLECT_MAX_CHANNELS=4
# Servidores coletados ao mesmo tempo (1 = sequencial).
COLLECT_SERVER_CONCURRENCY=1
COLLECT_COMMAND_TIMEOUT_MS=30000
COLLECT_SERVER_TIMEOUT_MS=600000
COLLECT_CONNECT_RETRIES=2
